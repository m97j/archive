# Dependencies and package-manager state
node_modules/
.pnpm-store/
*.tsbuildinfo

# Build and test output
.next/
out/
dist/
.turbo/
coverage/
playwright-report/
test-results/

# Runtime and framework caches
.cache/
.vercel/
.wrangler/
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases and generated state
supabase/.branches/
supabase/.temp/

# OS and editor state
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# Shared editor defaults are tracked; personal workspace files remain local.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Temporary files
tmp/
tmp.md

# Private local workspace
_local/
# Tool-generated guidance is local, not application source.
**/AGENTS.md
**/CLAUDE.md

# Private operational receipts are not part of the published source tree.
/docs/operations/evidence/
/.backup-output/

# Preserved legacy working directories. Their tracked implementation was
# replaced by apps/*; ignored caches, secrets, and nested Git metadata remain.
/frontend/
/backend/
