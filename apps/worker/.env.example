NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=
# Same certificate-verifying pool policy as apps/api; Supabase's public CA is bundled.
DATABASE_SSL_MODE=
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=4
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
# Local default; use the deployed Vercel URL in production.
PUBLICATION_WEBHOOK_URL=http://localhost:3000/api/revalidate
OUTBOX_WEBHOOK_SECRET=replace-with-a-long-random-secret
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_MILLISECONDS=1000
