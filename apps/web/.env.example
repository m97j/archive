NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ko
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ko,ja,zh,es,fr,de
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production: https://m97j-archive-core.hf.space
ARCHIVE_API_BASE_URL=http://localhost:7860
# Server-only. Required for the production private archive-core Space; omit for local development.
ARCHIVE_API_UPSTREAM_BEARER_TOKEN=
# Server-only legacy/local service token fallback when there is no private upstream gateway.
ARCHIVE_API_BEARER_TOKEN=
# Local development only. Production authoring must use a per-user Supabase session.
ARCHIVE_DEV_ADMIN_ACCESS_TOKEN=
# Shared only with the outbox worker that signs publication webhook requests.
OUTBOX_WEBHOOK_SECRET=replace-with-a-long-random-secret
