NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ko
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ko,ja,zh,es,fr,de
# Production: https://m97j-archive-core.hf.space
ARCHIVE_API_BASE_URL=http://localhost:7860
# Server-only. Required for the production private archive-core Space; omit for local development.
ARCHIVE_API_UPSTREAM_BEARER_TOKEN=
# Server-only legacy/local service token fallback when there is no private upstream gateway.
ARCHIVE_API_BEARER_TOKEN=
# Shared only with the outbox worker that signs publication webhook requests.
OUTBOX_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional capture v2. Legacy ANALYTICS_* flags and OUTBOX_WEBHOOK_SECRET cannot enable it.
# Review contracts/transfers/notice/deletion + real hourly cleanup before changing all three flags.
ACTIVITY_COLLECTION_ENABLED=false
ACTIVITY_POLICY_REVIEWED=false
ACTIVITY_RETENTION_SCHEDULER_REVIEWED=false
ACTIVITY_POLICY_VERSION=2026-10-14
ACTIVITY_OPERATOR_NAME=marchivej
ACTIVITY_CONTACT_EMAIL=mmnkjiae@gmail.com
# Policy limits, not a claim that expiry alone physically deletes bytes.
ACTIVITY_SESSION_RETENTION_HOURS=2
ACTIVITY_MODEL_RETENTION_DAYS=90
# Five independent random 32-byte values, each encoded as exactly 64 hexadecimal characters.
# Server-only: never NEXT_PUBLIC_, browser storage, chat, source or workflow artifacts.
ACTIVITY_COOKIE_SIGNING_SECRET=
ACTIVITY_SESSION_ENCRYPTION_KEY=
ACTIVITY_DELETE_HMAC_SECRET=
ACTIVITY_RAW_ENCRYPTION_KEY=
CRON_SECRET=
# New private Bucket, separate from images and the encrypted-backup Dataset.
ACTIVITY_HF_BUCKET=m97j/archive-activity
ACTIVITY_HF_HUB_TOKEN=
# Derive these from a fine-grained token restricted to the activity Bucket.
ACTIVITY_HF_S3_ACCESS_KEY_ID=
ACTIVITY_HF_S3_SECRET_ACCESS_KEY=
