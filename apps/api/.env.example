NODE_ENV=development
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=info
DATABASE_URL=
# Optional: remote connections always verify certificates; localhost defaults to no TLS.
# Supabase's public CA is bundled. Override it only with a newly trusted public CA.
DATABASE_SSL_MODE=
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=4
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
PUBLISHER_ROLE=archive_admin
CONTENT_COMPILER_VERSION=content-engine-v1
# Optional inference is disabled until machine endpoints and shared credentials are configured.
# KNOWLEDGE_ENGINE_API_KEY must match the provider's ARCHIVE_INFERENCE_API_KEY (32+ characters).
AI_PROVIDER_ENABLED=false
KNOWLEDGE_ENGINE_BASE_URL=https://m97j-knowledge-engine.hf.space
KNOWLEDGE_ENGINE_API_KEY=
# The legacy v1 activity Dataset sink is retired and cannot be enabled through environment flags.
# Optional v2 capture goes directly from Vercel to a new private Bucket; see apps/web/.env.example.
# Production identifiers (non-secret): account a604ebdf46c7c0f3945cb5c3b833bad2,
# bucket archive-image, public origin https://pub-d5bba009e2e54e8ea7cd4aff16c9eec4.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Optional administrator-only GA4 aggregate reports. No raw event export or new tracking.
GA4_REPORTING_ENABLED=false
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
# Server-only Google service-account PKCS8 PEM, with real newlines or escaped \n.
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
