# Supabase's public CA is bundled. Override it only with a newly trusted public CA.
DATABASE_SSL_MODE=
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=4
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
PUBLISHER_ROLE=archive_admin
CONTENT_COMPILER_VERSION=content-engine-v1
